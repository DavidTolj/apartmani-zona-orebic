/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/thank-you/*
  X-Robots-Tag: noindex, follow
  Cache-Control: no-store

/*/thank-you/*
  X-Robots-Tag: noindex, follow
  Cache-Control: no-store

/404.html
  X-Robots-Tag: noindex, follow

/.netlify/functions/*
  X-Robots-Tag: noindex, nofollow
